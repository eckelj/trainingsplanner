# Intervals.icu API Credentials
# Get your API key in Intervals.icu -> Settings -> Developer Settings (bottom of page)
INTERVALS_API_KEY=your_api_key_here

# Athlete ID: Use "0" for the account owning the API key, or your specific ID (e.g. i12345)
INTERVALS_ATHLETE_ID=0

# Base URL for API
INTERVALS_API_BASE=https://intervals.icu/api/v1
